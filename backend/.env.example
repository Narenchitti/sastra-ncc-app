# SASTRA NCC FastAPI Backend Configuration

# Live Supabase instance credentials
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_public_key

# Database choice
# Set to 'false' to use the live Supabase database instance.
# Set to 'true' if you want to run database actions locally on SQLite.
USE_SQLITE=false

# Port for FastAPI server
API_PORT=8000

# Security (JWT Auth)
# Generate a secure 32-character string in production
JWT_SECRET=your_secure_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Google Gemini API Key (Required for AI Audit and Natural Command Query features)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key
